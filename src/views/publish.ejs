<%- include('partials/header') %>

<div class="page-head">
  <h1>Publicar backing track</h1>
  <p class="muted">Escolha a música original, defina o preço e liste os stems que vão no pacote.</p>
</div>

<% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

<form method="post" action="/publish" class="form card publish-form">
  <label>Música original
    <select name="musica_id" required data-searchable data-search-placeholder="Digite a música, o artista ou o álbum">
      <option value="">Selecione...</option>
      <% songs.forEach(function (s) { %>
        <option value="<%= s.id %>" <%= Number(form.musica_id) === s.id ? 'selected' : '' %>>
          <%= s.artistas %> - <%= s.titulo %> (<%= s.album %>)
        </option>
      <% }) %>
    </select>
  </label>

  <label>Nome do backing track
    <input type="text" name="nome" value="<%= form.nome || '' %>" maxlength="60" placeholder="ex.: Cachoeira sem bateria" required>
  </label>

  <div class="form-row">
    <label>Preço (R$)
      <input type="text" name="valor" value="<%= form.valor || '' %>" inputmode="decimal" placeholder="19,90"
             maxlength="6" data-mask="price" autocomplete="off" required>
    </label>
    <label>Duração (mm:ss)
      <input type="text" name="duracao" value="<%= form.duracao || '' %>" inputmode="numeric" placeholder="3:45"
             maxlength="5" data-mask="duration" autocomplete="off" required>
    </label>
  </div>

  <fieldset>
    <legend>Stems</legend>
    <p class="small muted">Cada stem é uma faixa separada (só o baixo, só a bateria...).</p>
    <div id="stems">
      <% const rows = (form.stems && form.stems.length) ? form.stems : [{ nome: '', instrumento: '' }]; %>
      <% rows.forEach(function (s) { %>
        <div class="stem-row">
          <input type="text" name="stem_nome" value="<%= s.nome %>" placeholder="Nome da faixa" maxlength="60">
          <input type="text" name="stem_instrumento" value="<%= instrumentLabels[s.instrumento] || s.instrumento %>" placeholder="Instrumento"
                 maxlength="30" list="instrument-list" data-instrument autocomplete="off">
          <button type="button" class="btn btn-ghost btn-small" data-remove-stem aria-label="Remover">×</button>
        </div>
      <% }) %>
    </div>
    <datalist id="instrument-list">
      <% Object.keys(instrumentLabels).forEach(function (key) { %>
        <option value="<%= instrumentLabels[key] %>"></option>
      <% }) %>
    </datalist>
    <p class="field-hint small" data-stems-hint hidden></p>
    <button type="button" class="btn btn-ghost btn-small" id="add-stem">+ adicionar stem</button>
  </fieldset>

  <button type="submit" class="btn">Publicar</button>
</form>

<%- include('partials/footer') %>
