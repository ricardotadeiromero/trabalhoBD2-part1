# copie para .env e preencha
# connection string do postgres. Local: postgresql://postgres:senha@localhost:5432/ensaio
# no Neon (Dashboard > Connect) ela já vem com ?sslmode=require no final
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ensaio

# qualquer texto grande e aleatorio, serve pra assinar o cookie de sessao
SESSION_SECRET=troque-isso-aqui

PORT=3000
