# copie para .env e preencha
# connection string do Neon (Dashboard > Connect), com ?sslmode=require no final
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# qualquer texto grande e aleatorio, serve pra assinar o cookie de sessao
SESSION_SECRET=troque-isso-aqui

PORT=3000
